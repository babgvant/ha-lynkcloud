{
  "title": "Discover Energy LYNK Cloud",
  "config": {
    "step": {
      "user": {
        "title": "Connect to LYNK Cloud",
        "description": "Enter the credentials used at mylynkcloud.com.",
        "data": {"username": "Email or username", "password": "Password", "host": "Cloud server"}
      },
      "reauth_confirm": {
        "title": "Reconnect to LYNK Cloud",
