      "lifetime_charge": {"name": "Lifetime charge"}, "lifetime_discharge": {"name": "Lifetime discharge"},
      "terminal_voltage": {"name": "Terminal voltage"}, "current": {"name": "Current"},
      "battery_temperature": {"name": "Battery temperature"}, "bms_temperature": {"name": "BMS temperature"},
      "cell_average_voltage": {"name": "Cell average voltage"}, "cell_minimum_voltage": {"name": "Cell minimum voltage"},
      "cell_maximum_voltage": {"name": "Cell maximum voltage"}, "cell_spread": {"name": "Cell spread"},
      "installed_capacity": {"name": "Installed capacity"}
